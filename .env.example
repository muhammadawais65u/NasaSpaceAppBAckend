# Copy to .env; never commit .env

# Leave the three SUPABASE_* values empty to run in local development mode
# (SQLite file, any Bearer token accepted). Set all three for the real setup.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# optional: only for running migrations
SUPABASE_DB_URL=

NASA_API_KEY=your-nasa-api-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# optional: calm | watch | storm
DEMO_FORCE_ALERT=
